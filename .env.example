# ── Railway (Dioxus 서버) ─────────────────────────────────────────────
# Railway에서는 서비스 변수에 DATABASE_URL=${{Postgres.DATABASE_URL}} 로 참조한다.
# 로컬 개발: docker 로 띄운 Postgres (README의 "로컬 실행" 참고)
DATABASE_URL=postgres://postgres:postgres@localhost:55432/short_url

# 단축 URL의 기준 주소 = 사용자가 접속하는 공개 주소 (Cloudflare Worker 주소)
# 로컬 개발에서는 dx serve 주소
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Dioxus 서버 바인딩 (Railway는 PORT를 자동 주입한다)
IP=0.0.0.0
PORT=8080

# ── Cloudflare Worker ─────────────────────────────────────────────────
# wrangler.toml 의 [vars] RAILWAY_ORIGIN 에 Railway 공개 도메인을 적는다. 예:
# RAILWAY_ORIGIN=https://numeric-short-url-production.up.railway.app
